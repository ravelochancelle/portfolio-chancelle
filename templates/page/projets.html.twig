
{% extends 'base.html.twig' %}

{% block title %}Mes projets | Chancelle Ravelosoa{% endblock %}

{% block body %}
    <main class="projects-page">

        {# INTRODUCTION #}
        <section class="projects-hero container">
            <p class="eyebrow">MON TRAVAIL · MES RÉALISATIONS</p>

            <h1>Mes projets, mes compétences en action.</h1>

            <p class="projects-intro">
                À travers ces réalisations, je mets en pratique mes compétences
                en développement web, en intégration et en création numérique.
                Chaque projet représente une étape de mon parcours et une
                occasion de progresser.
            </p>
        </section>

        {# LISTE DES PROJETS #}
        <section
            class="projects-list container"
            aria-label="Présentation de mes projets"
        >

            {# PROJET 01 #}
            <article class="project-item">
                <div class="project-number" aria-hidden="true">01</div>

                <div class="project-content">
                    <p class="eyebrow">CRÉATION WEB</p>

                    <h2>Portfolio WordPress</h2>

                    <p class="project-description">
                        Création et organisation de pages web avec WordPress
                        et Elementor. Ce projet m'a permis de travailler sur
                        la structure des pages, la présentation des contenus
                        et l'identité visuelle.
                    </p>

                    <div class="project-tags" aria-label="Technologies utilisées">
                        <span>WordPress</span>
                        <span>Elementor</span>
                        <span>Canva</span>
                    </div>

                    <a
                        class="project-link"
                        href="{{ path('app_projet_wordpress') }}"
                    >
                        Découvrir le projet
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </article>

            {# PROJET 02 #}
            <article class="project-item">
                <div class="project-number" aria-hidden="true">02</div>

                <div class="project-content">
                    <p class="eyebrow">EXPÉRIENCE PROFESSIONNELLE</p>

                    <h2>Application MAMS</h2>

                    <p class="project-description">
                        Durant mon stage chez MSConsulting, j'ai participé
                        à un projet de gestion des déplacements et des
                        indemnités kilométriques. Cette expérience m'a
                        permis de découvrir les besoins d'une application
                        métier et de contribuer à certaines fonctionnalités
                        et à la préparation des interfaces.
                    </p>

                    <div class="project-tags" aria-label="Compétences mobilisées">
                        <span>PHP</span>
                        <span>Base de données</span>
                        <span>Balsamiq</span>
                    </div>

                    <a
                        class="project-link"
                        href="{{ path('app_projet_mams') }}"
                    >
                        Découvrir le projet
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </article>

            {# PROJET 03 #}
            <article class="project-item">
                <div class="project-number" aria-hidden="true">03</div>

                <div class="project-content">
                    <p class="eyebrow">PROJET DE FORMATION</p>

                    <h2>Application Sortir</h2>

                    <p class="project-description">
                        Un projet de développement web qui me permet
                        de mettre en pratique les concepts de PHP et
                        Symfony, de structurer une application et de
                        travailler avec une base de données MySQL.
                    </p>

                    <div class="project-tags" aria-label="Technologies utilisées">
                        <span>PHP</span>
                        <span>Symfony</span>
                        <span>MySQL</span>
                    </div>

                    <a
                        class="project-link"
                        href="{{ path('app_projet_sortir') }}"
                    >
                        Découvrir le projet
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </article>

            {# PROJET 04 #}
            <article class="project-item">
                <div class="project-number" aria-hidden="true">04</div>

                <div class="project-content">
                    <p class="eyebrow">INTÉGRATION WEB</p>

                    <h2>SkillDev — Landing page</h2>

                    <p class="project-description">
                        Reproduction d'une page de présentation d'une
                        plateforme de formation en ligne à partir d'un
                        modèle. Le travail porte sur la structure HTML,
                        l'organisation des sections et la mise en page CSS.
                    </p>

                    <div class="project-tags" aria-label="Technologies utilisées">
                        <span>HTML5</span>
                        <span>CSS3</span>
                        <span>Flexbox</span>
                        <span>CSS Grid</span>
                    </div>

                    <a
                        class="project-link"
                        href="{{ path('app_projet_skilldev') }}"
                    >
                        Découvrir le projet
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </article>

        </section>

        {# COMPÉTENCES ILLUSTRÉES PAR LES PROJETS #}
        <section class="projects-skills container">
            <p class="eyebrow">MON APPROCHE</p>

            <h2>Des compétences mises en pratique.</h2>

            <div class="projects-skills-grid">

                <article class="projects-skill">
                    <span class="skill-index">01</span>
                    <h3>Concevoir</h3>
                    <p>
                        Organiser les pages, structurer les contenus et
                        réfléchir à la présentation des interfaces.
                    </p>
                </article>

                <article class="projects-skill">
                    <span class="skill-index">02</span>
                    <h3>Développer</h3>
                    <p>
                        Mettre en pratique les langages et outils du
                        développement web à travers des projets concrets.
                    </p>
                </article>

                <article class="projects-skill">
                    <span class="skill-index">03</span>
                    <h3>Progresser</h3>
                    <p>
                        Consolider mes acquis, comprendre les problèmes
                        rencontrés et améliorer progressivement mon travail.
                    </p>
                </article>

            </div>
        </section>

        {# APPEL À L'ACTION #}
        <section class="projects-contact container">
            <p class="eyebrow">ET MAINTENANT ?</p>

            <h2>Construisons la suite ensemble.</h2>

            <p>
                Je souhaite mettre mes compétences en pratique,
                continuer à progresser et contribuer à des projets
                numériques au sein d'une équipe.
            </p>

            <a
                class="project-link"
                href="{{ path('app_contact') }}"
            >
                Me contacter
                <span aria-hidden="true">→</span>
            </a>
        </section>

    </main>
{% endblock %}
