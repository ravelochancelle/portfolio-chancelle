
{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}

    <section class="hero">

        <div class="hero-content">
            <p class="hero-subtitle">
                DÉVELOPPEUSE WEB ET CRÉATION NUMÉRIQUE
            </p>

            <h1>Chancelle RAVELOSOA</h1>
            <p class="hero-tagline">
                <span class="typing typing-1">Changer de voie,</span>
                <span class="typing typing-2">sans repartir de zéro.</span>
            </p>

            <p class="hero-description">
                Je transforme des idées en pages web claires et utiles,
                avec HTML, CSS, PHP et Symfony.
            </p>

            <a href="#projets" class="btn">Découvrir mes projets</a>
            <a href="#services" class="btn btn-secondary">Découvrir mes services</a>

        </div>

        <div class="hero-image">
            <img src="{{ asset('images/photo.jpg') }}" alt="Chancelle Ravelosoa">
        </div>

    </section>

    <section class="section">
        <h2>Aujourd'hui, je construis…</h2>

        <div class="cards cards-build">
            <article class="card card-feature">
                <span class="card-icon">&lt;/&gt;</span>
                <h3>Web</h3>
                <p>HTML, CSS, PHP, Symfony<br>WordPress, Elementor</p>
            </article>

            <article class="card card-feature">
                <span class="card-icon">✦</span>
                <h3>Création numérique</h3>
                <p>Canva, Photopea<br>Présentations, visuels</p>
            </article>

            <article class="card card-feature">
                <span class="card-icon">✓</span>
                <h3>Qualité &amp; tests</h3>
                <p>Parcours utilisateurs<br>Améliorations</p>
            </article>
        </div>
    </section>

    <section class="section">
        <div class="section-header">
            <h2>Mes projets récents</h2>
            <a class="link-more" href="{{ path('app_projets') }}">Voir tous mes projets →</a>
        </div>

        <div class="cards cards-projects">
            <article class="card card-project">
                <img class="card-image" src="{{ asset('images/Portfolio_wordpress.png') }}" alt="Capture d'écran du projet Sortir">
                <h3>Portfolio</h3>
                <p>
                    <span class="tag">Wordpress</span>
                    <span class="tag">Elementor</span>
                    <span class="tag">HTML</span>
                    <span class="tag">CSS</span>
                
                </p>
                <a class="btn btn-gold" href="{{ path('app_projets') }}">Voir le projet →</a>
            </article>

            <article class="card card-project">
                <img class="card-image" src="{{ asset('images/MAMS.png') }}" alt="Capture d'écran du projet Sortir">
                <h3>MAMS</h3>
                <p>
                    
                    <span class="tag">Symfony</span>
                    <span class="tag">PHP</span>
                    <span class="tag">MySQL</span>
                    <span class="tag">Bootstrap</span>
                    <span class="tag">Doctrine</span>
                    
                </p>
                <a class="btn btn-gold" href="{{ path('app_projets') }}">Voir le projet →</a>
            </article>

            <article class="card card-project">
                <img class="card-image" src="{{ asset('images/Sortir.png') }}" alt="Capture d'écran du projet Sortir">
                <h3>Sortir</h3>
                <p>
                    <span class="tag">Symfony</span>
                    <span class="tag">PHP</span>
                    <span class="tag">MySQL</span>
                    <span class="tag">Bootstrap</span>
                    <span class="tag">Doctrine</span>
                    
                </p>
                <a class="btn btn-gold" href="{{ path('app_projets') }}">Voir le projet →</a>
            </article>
        
        </div>
    </section>

    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const cardSections = document.querySelectorAll(
                ".cards-build, .cards-projects",
            );

            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("is-visible");
                            observer.unobserve(entry.target);
                        }
                    });
                },
                {
                    threshold: 0.25,
                },
            );

            cardSections.forEach((section) => {
                observer.observe(section);
            });
        });
    </script>

{% endblock %}
